DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driveon?schema=public"
# Use um valor aleatorio forte em producao, com pelo menos 32 caracteres.
JWT_SECRET="dev-only-change-me-with-32-plus-chars"
RESEND_API_KEY="re_xxxxxxxxx"
# Remetente atual de teste. Trocar para "Auttra <no-reply@mail.auttra.com.br>" depois de verificar o dominio no Resend.
RESEND_FROM="Auttra <onboarding@resend.dev>"
PASSWORD_RESET_URL_BASE="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
# Lista de origens permitidas (separadas por vírgula). Em produção (Railway),
# incluir "https://app.auttra.com.br" mantendo as origens de localhost apenas
# neste arquivo de exemplo para desenvolvimento.
CORS_ORIGIN="http://localhost:8080,http://localhost:5173"
PORT=4000

# Chave secreta do Cloudflare Turnstile (captcha do login). O valor abaixo e a
# chave de teste oficial da Cloudflare (sempre aprova) - troque em producao.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="https://seu-servico-evolution.railway.app"
EVOLUTION_API_TOKEN="seu-token-secreto"
EVOLUTION_API_INSTANCE="driveon"

